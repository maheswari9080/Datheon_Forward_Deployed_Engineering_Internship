# ==============================================================================
# Enterprise Intelligence Gateway (EIG) - Environment Configuration Template
# NOTE: Copy to .env for local runtime. Never commit production secrets.
# ==============================================================================

# Core Application Settings
APP_NAME="Enterprise Intelligence Gateway"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false
API_V1_STR="/api/v1"

# Cryptography & Security
SECRET_KEY="replace-with-a-cryptographically-secure-32-byte-hex-secret-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
APPROVAL_HMAC_SECRET="replace-with-high-entropy-hmac-secret-for-signing-approval-tokens"
APPROVAL_TTL_SECONDS=300

# Relational Database Storage
DATABASE_URL="sqlite+aiosqlite:///./data/eig.db"

# Vector Database Configuration
VECTOR_STORE_PROVIDER="chroma"
CHROMA_PERSIST_DIRECTORY="./data/chroma_db"
CHROMA_COLLECTION_NAME="eig_enterprise_knowledge"
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME="eig_enterprise_knowledge"

# Embeddings & Reranking
EMBEDDING_PROVIDER="mock"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384
RERANKER_PROVIDER="mock"
RERANKER_MODEL_NAME="bge-reranker-base"

# Ingestion Constraints
MAX_FILE_SIZE_BYTES=52428800
MAX_BATCH_DOCUMENTS=100
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=60

# RAG & Rate Limiting
MAX_CONTEXT_CHUNKS=5
RETRIEVAL_SCORE_THRESHOLD=0.25
CONTEXT_BUDGET_TOKENS=4000
RATE_LIMIT_PER_MINUTE=120
